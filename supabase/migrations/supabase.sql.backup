WHERE pubname = 'supabase_realtime' 
AND tablename IN ('mensajes_incidencia', 'incidencias');

-- Expected output: Should show two rows

-- =====================================================
-- NOTES:
-- =====================================================
-- - After running this script, real-time events will be
--   broadcast for INSERT, UPDATE, and DELETE operations
--   on these tables.
-- 
-- - Make sure your RLS policies allow users to access
--   the data they should receive via real-time.
--
-- - Real-time uses the same permissions as regular queries.
--   If a user can't SELECT a row, they won't receive
--   real-time events for it either.
--
-- - To disable real-time (if needed):
--   ALTER PUBLICATION supabase_realtime DROP TABLE mensajes_incidencia;
-- =====================================================


DO $$ 
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'tipo_cliente') THEN
        CREATE TYPE tipo_cliente AS ENUM ('personal', 'empresa');
    END IF;
END $$;

-- Add tipo_cliente column to clientes table
ALTER TABLE clientes 
ADD COLUMN IF NOT EXISTS tipo_cliente tipo_cliente DEFAULT 'empresa';

-- Add comment to document the column
COMMENT ON COLUMN clientes.tipo_cliente IS 'Type of client: personal (individual) or empresa (company)';

-- Optional: Update existing records (all default to 'empresa')
UPDATE clientes 
SET tipo_cliente = 'empresa' 
WHERE tipo_cliente IS NULL;

-- ============================================
-- Verification
-- ============================================

-- Check the column was added
SELECT 
    column_name,
    data_type,
    column_default,
    is_nullable
FROM information_schema.columns
WHERE table_name = 'clientes' 
  AND column_name = 'tipo_cliente';

-- ============================================
-- SUCCESS MESSAGE
-- ============================================
DO $$
BEGIN
    RAISE NOTICE '============================================';
    RAISE NOTICE '✅ Migration completed successfully!';
    RAISE NOTICE '============================================';
    RAISE NOTICE 'Added tipo_cliente column to clientes table';
    RAISE NOTICE 'Type: ENUM (personal, empresa)';
    RAISE NOTICE 'Default: empresa';
    RAISE NOTICE '============================================';
END $$;

-- ============================================
-- ADVISOR ASSISTANT CONVERSATIONS
-- ============================================
-- Migration to add advisor assistant conversation storage
-- Created: November 16, 2025

-- Conversations table for storing advisor chat sessions
CREATE TABLE IF NOT EXISTS conversaciones_asesor (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  asesor_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,
  titulo TEXT NOT NULL DEFAULT 'Nueva conversación',
  fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  fecha_ultima_actividad TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Messages table for storing individual advisor chat messages
CREATE TABLE IF NOT EXISTS mensajes_asesor (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  conversacion_id UUID NOT NULL REFERENCES conversaciones_asesor(id) ON DELETE CASCADE,
  rol TEXT NOT NULL CHECK (rol IN ('usuario', 'asistente')),
  contenido TEXT NOT NULL,
  metadatos JSONB, -- For storing sources, document links, etc.
  fecha TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Indexes for better query performance
CREATE INDEX IF NOT EXISTS idx_conversaciones_asesor_asesor_id ON conversaciones_asesor(asesor_id);
CREATE INDEX IF NOT EXISTS idx_conversaciones_asesor_fecha ON conversaciones_asesor(fecha_ultima_actividad DESC);
CREATE INDEX IF NOT EXISTS idx_mensajes_asesor_conversacion ON mensajes_asesor(conversacion_id);

-- Enable RLS
ALTER TABLE conversaciones_asesor ENABLE ROW LEVEL SECURITY;
ALTER TABLE mensajes_asesor ENABLE ROW LEVEL SECURITY;

-- RLS Policies for advisor conversations
CREATE POLICY "Advisors can view their own conversations"
  ON conversaciones_asesor FOR SELECT
  USING (asesor_id = auth.uid());

CREATE POLICY "Advisors can insert their own conversations"
  ON conversaciones_asesor FOR INSERT
  WITH CHECK (asesor_id = auth.uid());

CREATE POLICY "Advisors can update their own conversations"
  ON conversaciones_asesor FOR UPDATE
  USING (asesor_id = auth.uid());

CREATE POLICY "Advisors can delete their own conversations"
  ON conversaciones_asesor FOR DELETE
  USING (asesor_id = auth.uid());

-- RLS Policies for advisor messages
CREATE POLICY "Advisors can view messages from their conversations"
  ON mensajes_asesor FOR SELECT
  USING (
    conversacion_id IN (
      SELECT id FROM conversaciones_asesor WHERE asesor_id = auth.uid()
    )
  );

CREATE POLICY "Advisors can insert messages in their conversations"
  ON mensajes_asesor FOR INSERT
  WITH CHECK (
    conversacion_id IN (
      SELECT id FROM conversaciones_asesor WHERE asesor_id = auth.uid()
    )
  );

CREATE POLICY "Advisors can delete messages from their conversations"
  ON mensajes_asesor FOR DELETE
  USING (
    conversacion_id IN (
      SELECT id FROM conversaciones_asesor WHERE asesor_id = auth.uid()
    )
  );

create table if not exists public.user_roles (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references public.profiles(id) on delete cascade,
  rol user_role not null,
  created_at timestamptz not null default now(),
  unique (user_id, rol)
);

insert into public.user_roles (user_id, rol)
select id, rol from public.profiles
where rol is not null
on conflict do nothing;

alter table public.user_roles enable row level security;

create policy "Admins manage user roles"
  on public.user_roles
  for all
  using (auth.role() = 'service_role')
  with check (true);

create policy "Users read their roles"
  on public.user_roles
  for select
  using (auth.uid() = user_id);

-- ============================================
-- COMPLETE FINANCIAL SYSTEM IMPLEMENTATION
-- For Externaliza2 Platform
-- ============================================
-- This migration adds all tables and structures needed for the complete financial system

-- ============================================
-- 1. EXPAND DOCUMENT TYPES AND STATUS
-- ============================================

-- Add new document types for mixed financial sources
DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'tipo_documento_financiero') THEN
    CREATE TYPE tipo_documento_financiero AS ENUM (
      'pyg',                -- Profit & Loss statement
      'balance',            -- Balance sheet
      'mayor',              -- General ledger
      'extracto_bancario',  -- Bank statement
      'excel_personalizado',-- Custom Excel reports
      'nominas',            -- Payroll
      'prestamos',          -- Loan schedules
      'otro_financiero'     -- Other financial documents
    );
  END IF;
END $$;

-- ============================================
-- 2. FINANCIAL DOCUMENTS TABLE (Mixed Sources)
-- ============================================

CREATE TABLE IF NOT EXISTS documentos_financieros (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  cliente_id UUID REFERENCES clientes(id) ON DELETE CASCADE,
  asesor_id UUID REFERENCES profiles(id) ON DELETE SET NULL,
  nombre TEXT NOT NULL,
  tipo tipo_documento_financiero NOT NULL,
  periodo TEXT NOT NULL, -- e.g., "Q1 2024", "2024", "Enero 2024"
  ejercicio_fiscal TEXT, -- e.g., "2024"
  fecha_subida TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  url_archivo TEXT NOT NULL,
  tamanio BIGINT,
  procesado_ia BOOLEAN DEFAULT false,
  
  -- AI extracted data from financial documents
  datos_extraidos JSONB, -- Contains financial metrics extracted by AI
  
  -- AI analysis and commentary
  analisis_ia JSONB, -- Contains AI generated insights, alerts, recommendations
  
  -- Metadata
  notas TEXT,
  estado TEXT DEFAULT 'pendiente', -- pendiente, procesado, validado, en_uso
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_docs_financieros_cliente ON documentos_financieros(cliente_id);
CREATE INDEX IF NOT EXISTS idx_docs_financieros_tipo ON documentos_financieros(tipo);
CREATE INDEX IF NOT EXISTS idx_docs_financieros_periodo ON documentos_financieros(periodo);

-- ============================================
-- 3. ERP INTEGRATION & SEAT NUMBER TRACKING
-- ============================================

CREATE TABLE IF NOT EXISTS erp_asientos (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  cliente_id UUID REFERENCES clientes(id) ON DELETE CASCADE,
  documento_id UUID REFERENCES documentos(id) ON DELETE SET NULL,
  
  -- ERP seat (asiento) information
  nro_asiento TEXT NOT NULL,
  fecha_asiento DATE NOT NULL,
  descripcion TEXT,
  
  -- ERP integration tracking
  fecha_importacion TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  archivo_erp_origen TEXT, -- The ERP report file that was imported
  
  -- Matching information
  metodo_match TEXT, -- 'automatico', 'manual', 'secuencial'
  confianza_match DECIMAL(5,2), -- Confidence level of automatic matching
  
  -- Accounting entry details
  apuntes JSONB, -- Array of accounting line items (debe, haber, cuenta, concepto)
  total_debe DECIMAL(15,2),
  total_haber DECIMAL(15,2),
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_erp_asientos_cliente ON erp_asientos(cliente_id);
CREATE INDEX IF NOT EXISTS idx_erp_asientos_documento ON erp_asientos(documento_id);
CREATE INDEX IF NOT EXISTS idx_erp_asientos_nro ON erp_asientos(nro_asiento);
CREATE INDEX IF NOT EXISTS idx_erp_asientos_fecha ON erp_asientos(fecha_asiento);

-- ============================================
-- 4. LIBRO REGISTRO (INVOICE RECORD BOOK)
-- ============================================

CREATE TABLE IF NOT EXISTS libro_registro (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  cliente_id UUID REFERENCES clientes(id) ON DELETE CASCADE,
  
  -- Period information
  periodo TEXT NOT NULL, -- e.g., "Q1 2024", "Enero 2024"
  ejercicio_fiscal TEXT NOT NULL,
  tipo_libro TEXT NOT NULL, -- 'emitidas', 'recibidas', 'bienes_inversion'
  
  -- Generation metadata
  fecha_generacion TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  generado_por UUID REFERENCES profiles(id) ON DELETE SET NULL,
  
  -- File information
  url_archivo_excel TEXT, -- URL to generated Excel file
  
  -- Summary data
  total_facturas INTEGER,
  total_base_imponible DECIMAL(15,2),
  total_iva DECIMAL(15,2),
  total_importe DECIMAL(15,2),
  
  -- Document IDs included in this libro
  documentos_incluidos UUID[], -- Array of documento IDs
  
  -- Status
  estado TEXT DEFAULT 'generado', -- generado, importado_erp, contabilizado
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  
  UNIQUE(cliente_id, periodo, tipo_libro)
);

CREATE INDEX IF NOT EXISTS idx_libro_registro_cliente ON libro_registro(cliente_id);
CREATE INDEX IF NOT EXISTS idx_libro_registro_periodo ON libro_registro(periodo);

-- ============================================
-- 5. AI VERIFICATION & QUALITY CONTROL
-- ============================================

CREATE TABLE IF NOT EXISTS verificaciones_ia (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  documento_id UUID REFERENCES documentos(id) ON DELETE CASCADE,
  asesor_id UUID REFERENCES profiles(id) ON DELETE SET NULL,
  
  -- AI processing details
  fecha_procesamiento TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  modelo_ia TEXT, -- Which AI model was used
  confianza_global DECIMAL(5,2), -- Overall confidence score
  
  -- Field-level confidence scores
  confianzas_campos JSONB, -- {"fechaFactura": 98, "total": 95, ...}
  
  -- Advisor action
  accion TEXT, -- 'validado', 'rechazado', 'pendiente_revision'
  fecha_accion TIMESTAMP WITH TIME ZONE,
  comentarios_asesor TEXT,
  
  -- Changes made by advisor
  campos_corregidos JSONB, -- Which fields were manually corrected
  
  -- Learning feedback
  usado_entrenamiento BOOLEAN DEFAULT false,
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_verificaciones_ia_documento ON verificaciones_ia(documento_id);
CREATE INDEX IF NOT EXISTS idx_verificaciones_ia_accion ON verificaciones_ia(accion);

-- ============================================
-- 6. AI PERFORMANCE METRICS
-- ============================================

CREATE TABLE IF NOT EXISTS metricas_ia (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  
  -- Period
  fecha DATE NOT NULL,
  periodo TEXT NOT NULL, -- 'diario', 'semanal', 'mensual'
  
  -- Processing metrics
  documentos_procesados INTEGER DEFAULT 0,
  documentos_validados INTEGER DEFAULT 0,
  documentos_rechazados INTEGER DEFAULT 0,
  
  -- Accuracy metrics
  precision_promedio DECIMAL(5,2),
  precision_por_tipo JSONB, -- {"emitida": 96.5, "recibida": 94.2, ...}
  
  -- Confidence distribution
  alta_confianza INTEGER DEFAULT 0, -- >= 95%
  media_confianza INTEGER DEFAULT 0, -- 80-95%
  baja_confianza INTEGER DEFAULT 0, -- < 80%
  
  -- Error metrics
  errores_totales INTEGER DEFAULT 0,
  errores_por_tipo JSONB, -- {"fecha": 5, "nif": 3, "importe": 2, ...}
  
  -- Performance metrics
  tiempo_procesamiento_promedio INTEGER, -- in milliseconds
  
  -- Improvement tracking
  mejora_vs_periodo_anterior DECIMAL(5,2),
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  
  UNIQUE(fecha, periodo)
);

CREATE INDEX IF NOT EXISTS idx_metricas_ia_fecha ON metricas_ia(fecha);
CREATE INDEX IF NOT EXISTS idx_metricas_ia_periodo ON metricas_ia(periodo);

-- ============================================
-- 7. FINANCIAL MODELS (AI-Generated)
-- ============================================

CREATE TABLE IF NOT EXISTS modelos_financieros_cliente (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  cliente_id UUID REFERENCES clientes(id) ON DELETE CASCADE,
  
  -- Period
  periodo TEXT NOT NULL,
  ejercicio_fiscal TEXT NOT NULL,
  
  -- Source documents used to build this model
  documentos_fuente UUID[], -- Array of documento_financiero IDs
  fecha_calculo TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  
  -- Income Statement (P&L) data
  ingresos_operacionales DECIMAL(15,2),
  gastos_operacionales DECIMAL(15,2),
  resultado_operacional DECIMAL(15,2),
  gastos_financieros DECIMAL(15,2),
  ingresos_extraordinarios DECIMAL(15,2),
  gastos_extraordinarios DECIMAL(15,2),
  resultado_antes_impuestos DECIMAL(15,2),
  impuestos DECIMAL(15,2),
  resultado_neto DECIMAL(15,2),
  
  -- Balance Sheet data
  activo_corriente DECIMAL(15,2),
  activo_no_corriente DECIMAL(15,2),
  total_activo DECIMAL(15,2),
  pasivo_corriente DECIMAL(15,2),
  pasivo_no_corriente DECIMAL(15,2),
  patrimonio_neto DECIMAL(15,2),
  total_pasivo_patrimonio DECIMAL(15,2),
  
  -- Financial ratios
  ratio_liquidez DECIMAL(10,4),
  ratio_solvencia DECIMAL(10,4),
  ratio_endeudamiento DECIMAL(10,4),
  margen_bruto DECIMAL(10,4),
  margen_operacional DECIMAL(10,4),
  margen_neto DECIMAL(10,4),
  roi DECIMAL(10,4),
  roe DECIMAL(10,4),
  
  -- Cash flow (if available)
  flujo_efectivo_operaciones DECIMAL(15,2),
  flujo_efectivo_inversion DECIMAL(15,2),
  flujo_efectivo_financiacion DECIMAL(15,2),
  flujo_efectivo_neto DECIMAL(15,2),
  
  -- Detailed breakdowns (stored as JSONB for flexibility)
  gastos_por_categoria JSONB, -- {"personal": 50000, "suministros": 10000, ...}
  ingresos_por_linea JSONB,
  proveedores_principales JSONB, -- Top suppliers with amounts
  clientes_principales JSONB, -- Top customers with amounts
  
  -- AI analysis
  alertas_financieras JSONB, -- Array of alerts generated by AI
  recomendaciones_ia JSONB, -- Array of recommendations
  comentario_ia TEXT, -- Natural language summary
  
  -- Risk assessment
  nivel_riesgo TEXT, -- 'bajo', 'medio', 'alto'
  factores_riesgo JSONB, -- Array of risk factors identified
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  
  UNIQUE(cliente_id, periodo)
);

CREATE INDEX IF NOT EXISTS idx_modelos_financieros_cliente ON modelos_financieros_cliente(cliente_id);
CREATE INDEX IF NOT EXISTS idx_modelos_financieros_periodo ON modelos_financieros_cliente(periodo);

-- ============================================
-- 8. FINANCIAL QUERIES (E2 Assistant)
-- ============================================

CREATE TABLE IF NOT EXISTS consultas_financieras (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  cliente_id UUID REFERENCES clientes(id) ON DELETE CASCADE,
  usuario_id UUID REFERENCES profiles(id) ON DELETE SET NULL,
  
  -- Query details
  pregunta TEXT NOT NULL,
  respuesta TEXT NOT NULL,
  fecha TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  
  -- Context used
  documentos_referenciados UUID[], -- Array of document IDs used to answer
  fuentes_oficiales TEXT[], -- Array of official sources consulted
  
  -- Quality metrics
  calificacion_usuario INTEGER, -- 1-5 stars
  fue_util BOOLEAN,
  requirio_escalacion BOOLEAN DEFAULT false,
  
  -- Follow-up
  incidencia_creada UUID REFERENCES incidencias(id) ON DELETE SET NULL,
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_consultas_financieras_cliente ON consultas_financieras(cliente_id);
CREATE INDEX IF NOT EXISTS idx_consultas_financieras_fecha ON consultas_financieras(fecha);

-- ============================================
-- 9. AUDIT LOG FOR FINANCIAL ACTIONS
-- ============================================

CREATE TABLE IF NOT EXISTS auditoria_financiera (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  
  -- Who
  usuario_id UUID REFERENCES profiles(id) ON DELETE SET NULL,
  usuario_nombre TEXT NOT NULL,
  usuario_rol TEXT NOT NULL,
  
  -- What
  accion TEXT NOT NULL, -- 'validar_documento', 'generar_libro', 'exportar_excel', etc.
  entidad_tipo TEXT NOT NULL, -- 'documento', 'libro_registro', 'asiento_erp', etc.
  entidad_id UUID NOT NULL,
  
  -- Details
  descripcion TEXT NOT NULL,
  datos_anteriores JSONB, -- State before action
  datos_nuevos JSONB, -- State after action
  
  -- Context
  cliente_id UUID REFERENCES clientes(id) ON DELETE SET NULL,
  direccion_ip INET,
  user_agent TEXT,
  
  -- When
  fecha TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_auditoria_usuario ON auditoria_financiera(usuario_id);
CREATE INDEX IF NOT EXISTS idx_auditoria_accion ON auditoria_financiera(accion);
CREATE INDEX IF NOT EXISTS idx_auditoria_fecha ON auditoria_financiera(fecha);
CREATE INDEX IF NOT EXISTS idx_auditoria_cliente ON auditoria_financiera(cliente_id);

-- ============================================
-- 10. NOTIFICATION PREFERENCES & HISTORY
-- ============================================

CREATE TABLE IF NOT EXISTS preferencias_notificaciones (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  usuario_id UUID REFERENCES profiles(id) ON DELETE CASCADE,
  
  -- Email notifications
  notif_documentos_nuevos BOOLEAN DEFAULT true,
  notif_documentos_procesados BOOLEAN DEFAULT true,
  notif_incidencias_nuevas BOOLEAN DEFAULT true,
  notif_incidencias_resueltas BOOLEAN DEFAULT true,
  notif_libro_registro_generado BOOLEAN DEFAULT true,
  notif_alertas_financieras BOOLEAN DEFAULT true,
  notif_resumen_diario BOOLEAN DEFAULT false,
  notif_resumen_semanal BOOLEAN DEFAULT true,
  
  -- In-app notifications
  notif_inapp_enabled BOOLEAN DEFAULT true,
  
  -- Thresholds for alerts
  umbral_alerta_gastos DECIMAL(15,2),
  umbral_alerta_ingresos DECIMAL(15,2),
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  
  UNIQUE(usuario_id)
);

CREATE TABLE IF NOT EXISTS historial_notificaciones (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  usuario_id UUID REFERENCES profiles(id) ON DELETE CASCADE,
  
  -- Notification details
  tipo TEXT NOT NULL, -- 'email', 'inapp', 'sms'
  categoria TEXT NOT NULL, -- 'documento', 'incidencia', 'financiero', 'sistema'
  titulo TEXT NOT NULL,
  mensaje TEXT NOT NULL,
  
  -- Status
  enviado BOOLEAN DEFAULT false,
  fecha_envio TIMESTAMP WITH TIME ZONE,
  leido BOOLEAN DEFAULT false,
  fecha_lectura TIMESTAMP WITH TIME ZONE,
  
  -- Context
  enlace TEXT,
  datos_adicionales JSONB,
  
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_notificaciones_usuario ON historial_notificaciones(usuario_id);
CREATE INDEX IF NOT EXISTS idx_notificaciones_leido ON historial_notificaciones(leido);
CREATE INDEX IF NOT EXISTS idx_notificaciones_fecha ON historial_notificaciones(created_at);

-- ============================================
-- 11. UPDATE EXISTING TABLES
-- ============================================

-- Add tipo_cliente to clientes if not exists
DO $$ BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name='clientes' AND column_name='tipo_cliente'
  ) THEN
    ALTER TABLE clientes ADD COLUMN tipo_cliente TEXT DEFAULT 'empresa' CHECK (tipo_cliente IN ('autonomo', 'empresa'));
  END IF;
END $$;

-- Add more tracking fields to documentos
DO $$ BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name='documentos' AND column_name='fecha_validacion'
  ) THEN
    ALTER TABLE documentos ADD COLUMN fecha_validacion TIMESTAMP WITH TIME ZONE;
  END IF;
  
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name='documentos' AND column_name='validado_por'
  ) THEN
    ALTER TABLE documentos ADD COLUMN validado_por UUID REFERENCES profiles(id) ON DELETE SET NULL;
  END IF;
  
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name='documentos' AND column_name='fecha_contabilizacion'
  ) THEN
    ALTER TABLE documentos ADD COLUMN fecha_contabilizacion TIMESTAMP WITH TIME ZONE;
  END IF;
  
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name='documentos' AND column_name='incluido_en_libro'
  ) THEN
    ALTER TABLE documentos ADD COLUMN incluido_en_libro UUID REFERENCES libro_registro(id) ON DELETE SET NULL;
  END IF;
  
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name='documentos' AND column_name='bloqueado'
  ) THEN
    ALTER TABLE documentos ADD COLUMN bloqueado BOOLEAN DEFAULT false;
  END IF;
END $$;

-- Expand datos_financieros table
DO $$ BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name='datos_financieros' AND column_name='modelo_financiero_id'
  ) THEN
    ALTER TABLE datos_financieros ADD COLUMN modelo_financiero_id UUID REFERENCES modelos_financieros_cliente(id) ON DELETE SET NULL;
  END IF;
END $$;

-- ============================================
-- 12. FUNCTIONS & TRIGGERS
-- ============================================

-- Function to update updated_at timestamp
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Apply updated_at trigger to new tables
DROP TRIGGER IF EXISTS update_documentos_financieros_updated_at ON documentos_financieros;
CREATE TRIGGER update_documentos_financieros_updated_at
  BEFORE UPDATE ON documentos_financieros
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

DROP TRIGGER IF EXISTS update_erp_asientos_updated_at ON erp_asientos;
CREATE TRIGGER update_erp_asientos_updated_at
  BEFORE UPDATE ON erp_asientos
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

DROP TRIGGER IF EXISTS update_libro_registro_updated_at ON libro_registro;
CREATE TRIGGER update_libro_registro_updated_at
  BEFORE UPDATE ON libro_registro
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

DROP TRIGGER IF EXISTS update_verificaciones_ia_updated_at ON verificaciones_ia;
CREATE TRIGGER update_verificaciones_ia_updated_at
  BEFORE UPDATE ON verificaciones_ia
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

DROP TRIGGER IF EXISTS update_modelos_financieros_updated_at ON modelos_financieros_cliente;
CREATE TRIGGER update_modelos_financieros_updated_at
  BEFORE UPDATE ON modelos_financieros_cliente
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

-- Function to create audit log entry
CREATE OR REPLACE FUNCTION crear_log_auditoria(
  p_usuario_id UUID,
  p_usuario_nombre TEXT,
  p_usuario_rol TEXT,
  p_accion TEXT,
  p_entidad_tipo TEXT,
  p_entidad_id UUID,
  p_descripcion TEXT,
  p_datos_anteriores JSONB DEFAULT NULL,
  p_datos_nuevos JSONB DEFAULT NULL,
  p_cliente_id UUID DEFAULT NULL
)
RETURNS UUID AS $$
DECLARE
  v_audit_id UUID;
BEGIN
  INSERT INTO auditoria_financiera (
    usuario_id,
    usuario_nombre,
    usuario_rol,
    accion,
    entidad_tipo,
    entidad_id,
    descripcion,
    datos_anteriores,
    datos_nuevos,
    cliente_id
  ) VALUES (
    p_usuario_id,
    p_usuario_nombre,
    p_usuario_rol,
    p_accion,
    p_entidad_tipo,
    p_entidad_id,
    p_descripcion,
    p_datos_anteriores,
    p_datos_nuevos,
    p_cliente_id
  ) RETURNING id INTO v_audit_id;
  
  RETURN v_audit_id;
END;
$$ LANGUAGE plpgsql;

-- Function to calculate financial model for a client
CREATE OR REPLACE FUNCTION calcular_modelo_financiero(
  p_cliente_id UUID,
  p_periodo TEXT
)
RETURNS UUID AS $$
DECLARE
  v_modelo_id UUID;
  v_ingresos DECIMAL(15,2);
  v_gastos DECIMAL(15,2);
  v_resultado DECIMAL(15,2);
BEGIN
  -- Get data from datos_financieros
  SELECT ingresos, gastos, resultado
  INTO v_ingresos, v_gastos, v_resultado
  FROM datos_financieros
  WHERE cliente_id = p_cliente_id AND periodo = p_periodo
  LIMIT 1;
  
  -- Create or update financial model
  INSERT INTO modelos_financieros_cliente (
    cliente_id,
    periodo,
    ejercicio_fiscal,
    ingresos_operacionales,
    gastos_operacionales,
    resultado_operacional,
    resultado_neto,
    margen_neto
  ) VALUES (
    p_cliente_id,
    p_periodo,
    EXTRACT(YEAR FROM NOW())::TEXT,
    COALESCE(v_ingresos, 0),
    COALESCE(v_gastos, 0),
    COALESCE(v_resultado, 0),
    COALESCE(v_resultado, 0),
    CASE WHEN COALESCE(v_ingresos, 0) > 0 
      THEN (COALESCE(v_resultado, 0) / COALESCE(v_ingresos, 1)) * 100 
      ELSE 0 
    END
  )
  ON CONFLICT (cliente_id, periodo) 
  DO UPDATE SET
    ingresos_operacionales = EXCLUDED.ingresos_operacionales,
    gastos_operacionales = EXCLUDED.gastos_operacionales,
    resultado_operacional = EXCLUDED.resultado_operacional,
    resultado_neto = EXCLUDED.resultado_neto,
    margen_neto = EXCLUDED.margen_neto,
    fecha_calculo = NOW()
  RETURNING id INTO v_modelo_id;
  
  RETURN v_modelo_id;
END;
$$ LANGUAGE plpgsql;

-- ============================================
-- 13. ROW LEVEL SECURITY (RLS) POLICIES
-- ============================================

-- Enable RLS on new tables
ALTER TABLE documentos_financieros ENABLE ROW LEVEL SECURITY;
ALTER TABLE erp_asientos ENABLE ROW LEVEL SECURITY;
ALTER TABLE libro_registro ENABLE ROW LEVEL SECURITY;
ALTER TABLE verificaciones_ia ENABLE ROW LEVEL SECURITY;
ALTER TABLE metricas_ia ENABLE ROW LEVEL SECURITY;
ALTER TABLE modelos_financieros_cliente ENABLE ROW LEVEL SECURITY;
ALTER TABLE consultas_financieras ENABLE ROW LEVEL SECURITY;
ALTER TABLE auditoria_financiera ENABLE ROW LEVEL SECURITY;
ALTER TABLE preferencias_notificaciones ENABLE ROW LEVEL SECURITY;
ALTER TABLE historial_notificaciones ENABLE ROW LEVEL SECURITY;

-- Policies for documentos_financieros
DROP POLICY IF EXISTS "Admin full access to documentos_financieros" ON documentos_financieros;
CREATE POLICY "Admin full access to documentos_financieros" ON documentos_financieros
  FOR ALL USING (
    EXISTS (
      SELECT 1 FROM profiles WHERE id = auth.uid() AND rol = 'admin'
    )
  );

DROP POLICY IF EXISTS "Asesor access to assigned clients financieros" ON documentos_financieros;
CREATE POLICY "Asesor access to assigned clients financieros" ON documentos_financieros
  FOR ALL USING (
    EXISTS (
      SELECT 1 FROM asesor_cliente ac
      JOIN profiles p ON p.id = auth.uid()
      WHERE ac.asesor_id = p.id 
      AND ac.cliente_id = documentos_financieros.cliente_id
      AND p.rol = 'asesor'
    )
  );

DROP POLICY IF EXISTS "Cliente access to own documentos_financieros" ON documentos_financieros;
CREATE POLICY "Cliente access to own documentos_financieros" ON documentos_financieros
  FOR SELECT USING (
    EXISTS (
      SELECT 1 FROM clientes c
      JOIN profiles p ON p.id = auth.uid()
      WHERE c.id = documentos_financieros.cliente_id 
      AND c.user_id = p.id
      AND p.rol = 'cliente'
    )
  );

-- Similar policies for other tables (simplified for brevity)
DROP POLICY IF EXISTS "Admin full access to erp_asientos" ON erp_asientos;
CREATE POLICY "Admin full access to erp_asientos" ON erp_asientos FOR ALL USING (
  EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND rol = 'admin')
);

DROP POLICY IF EXISTS "Admin full access to modelos_financieros" ON modelos_financieros_cliente;
CREATE POLICY "Admin full access to modelos_financieros" ON modelos_financieros_cliente FOR ALL USING (
  EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND rol = 'admin')
);

DROP POLICY IF EXISTS "Admin full access to auditoria" ON auditoria_financiera;
CREATE POLICY "Admin full access to auditoria" ON auditoria_financiera FOR ALL USING (
  EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND rol = 'admin')
);

DROP POLICY IF EXISTS "Users access own notifications" ON historial_notificaciones;
CREATE POLICY "Users access own notifications" ON historial_notificaciones FOR ALL USING (
  usuario_id = auth.uid()
);

-- ============================================
-- MIGRATION COMPLETE
-- ============================================

-- Add comments to tables for documentation
COMMENT ON TABLE documentos_financieros IS 'Mixed financial source documents: P&L, Balance, Ledger, etc.';
COMMENT ON TABLE erp_asientos IS 'ERP accounting entries with seat numbers and matching to invoices';
COMMENT ON TABLE libro_registro IS 'Generated invoice record books (Libro Registro) for each period';
COMMENT ON TABLE verificaciones_ia IS 'AI verification workflow with advisor validation';
COMMENT ON TABLE metricas_ia IS 'AI performance metrics and accuracy tracking';
COMMENT ON TABLE modelos_financieros_cliente IS 'AI-generated financial models per client with ratios and analysis';
COMMENT ON TABLE consultas_financieras IS 'Financial queries handled by E2 Assistant';
COMMENT ON TABLE auditoria_financiera IS 'Audit log for all financial actions in the platform';

-- ============================================
-- UPDATE DOCUMENT TYPE ENUM
-- Migration to update document_type enum to new values
-- ============================================
-- This migration updates the document_type enum from:
--   'emitida', 'recibida', 'nomina', 'gasto', 'otro'
-- To:
--   'otro', 'emitida_pdf', 'recibida_pdf', 'emitida_excel', 'recibida_excel'

-- Step 1: Create new enum type with the new values
DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'document_type_new') THEN
    CREATE TYPE document_type_new AS ENUM (
      'otro',
      'emitida_pdf',
      'recibida_pdf',
      'emitida_excel',
      'recibida_excel'
    );
  END IF;
END $$;

-- Step 2: Add temporary column with new enum type
DO $$ BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name='documentos' AND column_name='tipo_new'
  ) THEN
    ALTER TABLE documentos ADD COLUMN tipo_new document_type_new;
  END IF;
END $$;

-- Step 3: Migrate existing data
-- Map old values to new values:
--   'emitida' -> 'emitida_pdf'
--   'recibida' -> 'recibida_pdf'
--   'nomina' -> 'otro'
--   'gasto' -> 'otro'
--   'otro' -> 'otro'
UPDATE documentos
SET tipo_new = CASE
  WHEN tipo::text = 'emitida' THEN 'emitida_pdf'::document_type_new
  WHEN tipo::text = 'recibida' THEN 'recibida_pdf'::document_type_new
  WHEN tipo::text = 'nomina' THEN 'otro'::document_type_new
  WHEN tipo::text = 'gasto' THEN 'otro'::document_type_new
  WHEN tipo::text = 'otro' THEN 'otro'::document_type_new
  ELSE 'otro'::document_type_new
END;

-- Step 4: Make the new column NOT NULL (after migration)
ALTER TABLE documentos ALTER COLUMN tipo_new SET NOT NULL;

-- Step 5: Drop the old column
ALTER TABLE documentos DROP COLUMN tipo;

-- Step 6: Rename the new column to the original name
ALTER TABLE documentos RENAME COLUMN tipo_new TO tipo;

-- Step 7: Drop the old enum type (only if no other tables use it)
-- Note: This will fail if other tables use document_type enum
-- If that's the case, you'll need to update those tables first
DO $$ 
BEGIN
  -- Check if any other tables use the old enum
  IF NOT EXISTS (
    SELECT 1 
    FROM information_schema.columns 
    WHERE udt_name = 'document_type'
    AND table_name != 'documentos'
  ) THEN
    DROP TYPE document_type;
  ELSE
    RAISE NOTICE 'Cannot drop document_type enum - other tables still use it';
  END IF;
END $$;

-- Step 8: Rename the new enum type to the original name
DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_type WHERE typname = 'document_type_new') THEN
    ALTER TYPE document_type_new RENAME TO document_type;
  END IF;
END $$;

-- Step 9: Add comment for documentation
COMMENT ON TYPE document_type IS 'Document types: otro, emitida_pdf, recibida_pdf, emitida_excel, recibida_excel';

-- ============================================
-- Migration: Allow All MIME Types for documentos Bucket
-- ============================================
-- This migration updates the 'documentos' storage bucket to accept all file types
-- instead of the restricted list currently configured (PDF, XML, JPEG, PNG only)

-- Step 1: Check current bucket configuration
DO $$
DECLARE
  bucket_exists BOOLEAN;
  current_allowed_types TEXT[];
BEGIN
  -- Check if bucket exists
  SELECT EXISTS(SELECT 1 FROM storage.buckets WHERE id = 'documentos') INTO bucket_exists;
  
  IF NOT bucket_exists THEN
    RAISE EXCEPTION 'Bucket "documentos" does not exist. Please create it first in the Supabase Dashboard.';
  END IF;
  
  -- Get current allowed MIME types
  SELECT allowed_mime_types INTO current_allowed_types
  FROM storage.buckets
  WHERE id = 'documentos';
  
  IF current_allowed_types IS NOT NULL THEN
    RAISE NOTICE 'Current allowed MIME types: %', array_to_string(current_allowed_types, ', ');
  ELSE
    RAISE NOTICE 'Bucket currently has no MIME type restrictions (allows all types)';
  END IF;
END $$;

-- Step 2: Update the bucket to allow ALL MIME types
-- Setting allowed_mime_types to NULL removes all restrictions
UPDATE storage.buckets
SET 
  allowed_mime_types = NULL
WHERE id = 'documentos';

-- Step 3: Verify the update was successful
DO $$
DECLARE
  updated_allowed_types TEXT[];
  row_count INTEGER;
BEGIN
  -- Check how many rows were updated
  GET DIAGNOSTICS row_count = ROW_COUNT;
  
  IF row_count = 0 THEN
    RAISE WARNING 'No rows were updated. Bucket "documentos" may not exist.';
  ELSE
    RAISE NOTICE 'Updated % row(s)', row_count;
  END IF;
  
  -- Verify the new configuration
  SELECT allowed_mime_types INTO updated_allowed_types
  FROM storage.buckets
  WHERE id = 'documentos';
  
  IF updated_allowed_types IS NULL THEN
    RAISE NOTICE 'SUCCESS: Bucket "documentos" now accepts ALL MIME types (restrictions removed)';
    RAISE NOTICE 'The bucket will show "Any" in the Supabase Dashboard';
  ELSE
    RAISE WARNING 'Update may not have worked. Current allowed types: %', array_to_string(updated_allowed_types, ', ');
    RAISE NOTICE 'Try the alternative approach below if this did not work';
  END IF;
END $$;

-- ============================================
-- Alternative Approach (if NULL doesn't work)
-- ============================================
-- If setting to NULL doesn't work, explicitly include all needed MIME types
-- Uncomment the section below if the above UPDATE didn't work:

/*
-- Option: Explicitly include common types including Excel
-- This includes all the original types plus Excel and other common document types
