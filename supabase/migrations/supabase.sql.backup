-- ============================================
-- FIX CLIENTES TABLE RLS POLICIES
-- This script allows admins and asesores to fully manage clients
-- ============================================

-- Drop existing policies
DROP POLICY IF EXISTS "Clientes can view their own data" ON clientes;
DROP POLICY IF EXISTS "Admins can manage all clients" ON clientes;
DROP POLICY IF EXISTS "Asesores can view their assigned clients" ON clientes;

-- Enable RLS on clientes table (if not already enabled)
ALTER TABLE clientes ENABLE ROW LEVEL SECURITY;

-- ============================================
-- CLIENTES POLICIES
-- ============================================

-- Policy 1: Clientes can view their own data
CREATE POLICY "Clientes can view their own data" ON clientes
    FOR SELECT 
    USING (user_id = auth.uid());

-- Policy 2: Admins have full access to all clients
CREATE POLICY "Admins have full access" ON clientes
    FOR ALL 
    USING (
        EXISTS (
            SELECT 1 FROM profiles 
            WHERE id = auth.uid() AND rol = 'admin'
        )
    )
    WITH CHECK (
        EXISTS (
            SELECT 1 FROM profiles 
            WHERE id = auth.uid() AND rol = 'admin'
        )
    );

-- Policy 3: Asesores can view their assigned clients
CREATE POLICY "Asesores can view assigned clients" ON clientes
    FOR SELECT 
    USING (
        EXISTS (
            SELECT 1 FROM profiles 
            WHERE id = auth.uid() AND rol = 'asesor'
        )
    );

-- Policy 4: Asesores can insert new clients
CREATE POLICY "Asesores can insert clients" ON clientes
    FOR INSERT 
    WITH CHECK (
        EXISTS (
            SELECT 1 FROM profiles 
            WHERE id = auth.uid() AND rol = 'asesor'
        )
    );

-- Policy 5: Asesores can update their assigned clients
CREATE POLICY "Asesores can update assigned clients" ON clientes
    FOR UPDATE 
    USING (
        EXISTS (
            SELECT 1 FROM profiles 
            WHERE id = auth.uid() AND rol = 'asesor'
        ) AND (
            EXISTS (
                SELECT 1 FROM asesor_cliente 
                WHERE asesor_id = auth.uid() AND cliente_id = clientes.id
            )
        )
    )
    WITH CHECK (
        EXISTS (
            SELECT 1 FROM profiles 
            WHERE id = auth.uid() AND rol = 'asesor'
        )
    );

-- Policy 6: Asesores can delete their assigned clients
CREATE POLICY "Asesores can delete assigned clients" ON clientes
    FOR DELETE 
    USING (
        EXISTS (
            SELECT 1 FROM profiles 
            WHERE id = auth.uid() AND rol = 'asesor'
        ) AND (
            EXISTS (
                SELECT 1 FROM asesor_cliente 
                WHERE asesor_id = auth.uid() AND cliente_id = clientes.id
            )
        )
    );

-- ============================================
-- VERIFICATION QUERIES
-- ============================================

