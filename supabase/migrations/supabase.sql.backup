    RAISE NOTICE 'Test signup at: http://localhost:5000/signup';
    RAISE NOTICE '============================================';
END $$;

-- Fix for signup error: "Database error saving new user"
-- This creates a more robust trigger function with better error handling

-- Drop existing trigger if it exists
DROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;

-- Drop existing function
DROP FUNCTION IF EXISTS public.handle_new_user();

-- Create improved function with better error handling
CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS TRIGGER 
SECURITY DEFINER
SET search_path = public
LANGUAGE plpgsql
AS $$
DECLARE
    user_nombre TEXT;
    user_rol user_role;
BEGIN
    -- Extract nombre from metadata, default to 'Usuario'
    user_nombre := COALESCE(NEW.raw_user_meta_data->>'nombre', 'Usuario');
    
    -- Extract and cast rol, with proper error handling
    BEGIN
        user_rol := COALESCE((NEW.raw_user_meta_data->>'rol')::user_role, 'cliente'::user_role);
    EXCEPTION WHEN OTHERS THEN
        user_rol := 'cliente'::user_role;
    END;
    
    -- Insert the profile
    INSERT INTO public.profiles (id, nombre, email, rol, estado, fecha_alta)
    VALUES (
        NEW.id,
        user_nombre,
        NEW.email,
        user_rol,
        'activo',
        NOW()
    );
    
    RETURN NEW;
EXCEPTION
    WHEN unique_violation THEN
        -- Profile already exists, just return
        RETURN NEW;
    WHEN OTHERS THEN
        -- Log error and return (don't block user creation)
        RAISE WARNING 'Error creating profile for user %: %', NEW.id, SQLERRM;
        RETURN NEW;
END;
$$;

-- Create the trigger
CREATE TRIGGER on_auth_user_created
    AFTER INSERT ON auth.users
    FOR EACH ROW
    EXECUTE FUNCTION public.handle_new_user();

-- Grant necessary permissions
GRANT USAGE ON SCHEMA public TO postgres, anon, authenticated, service_role;
GRANT ALL ON ALL TABLES IN SCHEMA public TO postgres, anon, authenticated, service_role;
GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO postgres, anon, authenticated, service_role;
GRANT ALL ON ALL FUNCTIONS IN SCHEMA public TO postgres, anon, authenticated, service_role;

-- Verify the trigger was created
SELECT 
    trigger_name,
    event_manipulation,
    event_object_table,
    action_statement
FROM information_schema.triggers
WHERE trigger_name = 'on_auth_user_created';

-- ============================================
-- Auto-create Cliente record when user with rol='cliente' signs up
-- ============================================
-- This function should be run AFTER the fresh_install schema

-- Drop existing function and trigger if they exist
DROP TRIGGER IF EXISTS on_profile_created_cliente ON profiles;
DROP FUNCTION IF EXISTS public.handle_new_cliente() CASCADE;

-- Function to create cliente record when a profile with rol='cliente' is created
CREATE OR REPLACE FUNCTION public.handle_new_cliente()
RETURNS TRIGGER 
SECURITY DEFINER
SET search_path = public
LANGUAGE plpgsql
AS $$
BEGIN
    -- Only create cliente if the role is 'cliente'
    IF NEW.rol = 'cliente' THEN
        INSERT INTO public.clientes (
            user_id,
            nif,
            razon_social,
            nombre_comercial,
            persona_contacto,
            telefono,
            email,
            direccion_fiscal,
            estado,
            modulo_subida_documentos,
            modulo_incidencias,
            modulo_asistente_e2,
            modulo_panel_financiero,
            modulo_facturacion
        ) VALUES (
            NEW.id,
            'PENDING', -- El cliente deberá actualizar esto después
            NEW.nombre, -- Usar el nombre del perfil como razón social temporal
            NEW.nombre,
            NEW.nombre,
            COALESCE(NEW.telefono, 'PENDING'),
            NEW.email,
            'PENDING', -- El cliente deberá actualizar esto después
            'activo',
            true,  -- subida_documentos enabled by default
            true,  -- incidencias enabled by default
            false, -- asistente_e2 disabled by default
            false, -- panel_financiero disabled by default
            false  -- facturacion disabled by default
        )
        ON CONFLICT (user_id) DO NOTHING; -- Prevent duplicates
    END IF;
    
    RETURN NEW;
EXCEPTION
    WHEN unique_violation THEN
        -- Cliente already exists, just return
        RETURN NEW;
    WHEN OTHERS THEN
        -- Log error and return (don't block profile creation)
        RAISE WARNING 'Error creating cliente for user %: %', NEW.id, SQLERRM;
        RETURN NEW;
END;
$$;

-- Create trigger to run after profile insert
CREATE TRIGGER on_profile_created_cliente
    AFTER INSERT ON profiles
    FOR EACH ROW EXECUTE FUNCTION public.handle_new_cliente();

-- ============================================
-- Verify the trigger is created
-- ============================================

SELECT 
    trigger_name,
    event_object_table,
    action_timing,
    event_manipulation
FROM information_schema.triggers
WHERE trigger_name = 'on_profile_created_cliente';

-- ============================================
-- SUCCESS MESSAGE
-- ============================================
DO $$
BEGIN
    RAISE NOTICE '============================================';
    RAISE NOTICE '✅ Cliente auto-creation trigger installed!';
    RAISE NOTICE '============================================';
    RAISE NOTICE 'When a user signs up with rol=cliente:';
    RAISE NOTICE '1. Profile is created (existing trigger)';
    RAISE NOTICE '2. Cliente record is auto-created (NEW trigger)';
    RAISE NOTICE '';
    RAISE NOTICE 'Note: NIF and direccion_fiscal will be "PENDING"';
    RAISE NOTICE 'Users should update these in their profile.';
    RAISE NOTICE '============================================';
END $$;

-- ============================================
-- Add UNIQUE constraint to clientes.user_id
-- ============================================
-- This prevents having multiple cliente records for the same user

-- Add unique constraint if it doesn't exist
DO $$ 
BEGIN
    -- Check if constraint already exists
    IF NOT EXISTS (
        SELECT 1 FROM pg_constraint 
        WHERE conname = 'clientes_user_id_unique'
    ) THEN
        ALTER TABLE clientes 
        ADD CONSTRAINT clientes_user_id_unique UNIQUE (user_id);
        
        RAISE NOTICE '✅ Added UNIQUE constraint on clientes.user_id';
    ELSE
        RAISE NOTICE 'ℹ️  UNIQUE constraint already exists on clientes.user_id';
    END IF;
END $$;

-- Create index if it doesn't exist (for performance)
CREATE INDEX IF NOT EXISTS idx_clientes_user_id_unique ON clientes(user_id);

-- ============================================
-- STORAGE BUCKET SETUP FOR DOCUMENTS
-- ============================================
-- This script sets up the storage bucket for document uploads
-- Run this after the main schema setup

-- Create the storage bucket for documents
INSERT INTO storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
VALUES (
  'documentos',
  'documentos',
  true,  -- Make bucket public so users can access their uploaded files
  10485760,  -- 10MB file size limit
  ARRAY['application/pdf', 'application/xml', 'text/xml', 'image/jpeg', 'image/jpg', 'image/png']
)
ON CONFLICT (id) DO UPDATE SET
  public = EXCLUDED.public,
  file_size_limit = EXCLUDED.file_size_limit,
  allowed_mime_types = EXCLUDED.allowed_mime_types;

-- ============================================
-- STORAGE POLICIES (RLS for Storage)
-- ============================================

-- Policy: Allow authenticated users to upload files to their client folder
CREATE POLICY "Users can upload to their client folder"
ON storage.objects FOR INSERT
TO authenticated
WITH CHECK (
  bucket_id = 'documentos' AND
  -- Extract cliente_id from path (format: cliente_id/filename)
  (storage.foldername(name))[1] IN (
    SELECT c.id::text
    FROM clientes c
    WHERE c.user_id = auth.uid()
  )
);

-- Policy: Allow users to read files from their client folder
CREATE POLICY "Users can view their client files"
ON storage.objects FOR SELECT
TO authenticated
USING (
  bucket_id = 'documentos' AND
  (
    -- Cliente can view their own files
    (storage.foldername(name))[1] IN (
      SELECT c.id::text
      FROM clientes c
      WHERE c.user_id = auth.uid()
    )
    OR
    -- Asesor can view files from assigned clients
    (storage.foldername(name))[1] IN (
      SELECT ac.cliente_id::text
      FROM asesor_cliente ac
      JOIN profiles p ON ac.asesor_id = p.id
      WHERE p.id = auth.uid()
    )
    OR
    -- Admin can view all files
    EXISTS (
      SELECT 1 FROM profiles p
      WHERE p.id = auth.uid() AND p.rol = 'admin'
    )
  )
);

-- Policy: Allow users to delete their pending documents
CREATE POLICY "Users can delete their pending documents"
ON storage.objects FOR DELETE
TO authenticated
USING (
  bucket_id = 'documentos' AND
  (storage.foldername(name))[1] IN (
    SELECT c.id::text
    FROM clientes c
    WHERE c.user_id = auth.uid()
  )
);

-- Policy: Allow asesors and admins to view all files from their clients
CREATE POLICY "Asesors can view client files"
ON storage.objects FOR SELECT
TO authenticated
USING (
  bucket_id = 'documentos' AND
  (
    EXISTS (
      SELECT 1
      FROM asesor_cliente ac
      WHERE ac.cliente_id::text = (storage.foldername(name))[1]
        AND ac.asesor_id = auth.uid()
    )
    OR
    EXISTS (
      SELECT 1 FROM profiles p
      WHERE p.id = auth.uid() AND p.rol IN ('admin', 'asesor')
    )
  )
);

-- ============================================
-- VERIFICATION
-- ============================================

-- Check bucket exists
SELECT 
  id, 
  name, 
  public, 
  file_size_limit,
  allowed_mime_types
FROM storage.buckets
WHERE id = 'documentos';

-- Check policies
SELECT 
  policyname,
  cmd,
  qual
FROM pg_policies
WHERE schemaname = 'storage' AND tablename = 'objects';

-- Success message
DO $$
BEGIN
    RAISE NOTICE '============================================';
    RAISE NOTICE '✅ STORAGE BUCKET SETUP COMPLETED!';
    RAISE NOTICE '============================================';
    RAISE NOTICE 'Bucket created: documentos';
    RAISE NOTICE 'File size limit: 10MB';
    RAISE NOTICE 'Allowed types: PDF, XML, JPG, PNG';
    RAISE NOTICE 'RLS policies configured';
    RAISE NOTICE '============================================';
END $$;

-- Database updates for incidencias feature with file attachments
-- Run these SQL commands in your Supabase SQL editor

-- 1. Add file attachment support to mensajes_incidencia table
ALTER TABLE mensajes_incidencia 
ADD COLUMN IF NOT EXISTS archivos_adjuntos JSONB DEFAULT '[]'::jsonb,
ADD COLUMN IF NOT EXISTS es_ia BOOLEAN DEFAULT false,
ADD COLUMN IF NOT EXISTS rol VARCHAR(20) DEFAULT 'cliente';

-- 2. Create storage bucket for incident attachments
INSERT INTO storage.buckets (id, name, public)
VALUES ('incidencias', 'incidencias', true)
ON CONFLICT (id) DO NOTHING;

-- 3. Set up RLS policies for incidencias storage bucket
CREATE POLICY "Users can upload incident attachments" ON storage.objects
FOR INSERT WITH CHECK (bucket_id = 'incidencias' AND auth.role() = 'authenticated');

CREATE POLICY "Users can view incident attachments" ON storage.objects
FOR SELECT USING (bucket_id = 'incidencias' AND auth.role() = 'authenticated');

-- 4. Update mensajes_incidencia table to include rol information
-- This will help distinguish between different user types in messages
UPDATE mensajes_incidencia 
SET rol = 'cliente' 
WHERE rol IS NULL;

-- 5. Create index for better performance on incident queries
CREATE INDEX IF NOT EXISTS idx_incidencias_cliente_estado 
ON incidencias(cliente_id, estado);

CREATE INDEX IF NOT EXISTS idx_mensajes_incidencia_fecha 
ON mensajes_incidencia(incidencia_id, fecha);

-- 6. Add function to get user role for message display
CREATE OR REPLACE FUNCTION get_user_role(user_id UUID)
RETURNS VARCHAR(20) AS $$
BEGIN
  RETURN (
    SELECT rol 
    FROM profiles 
    WHERE id = user_id
  );
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- 7. Update the getIncidencias function to include proper role information
-- This is handled in the application code, but here's the SQL for reference
-- The application should join with profiles table to get user roles

-- RLS Policies Update for Incidencias Feature
-- Run this SQL in your Supabase SQL editor to fix the "row-level security policy" error

-- 1. Enable RLS on incidencias table if not already enabled
ALTER TABLE public.incidencias ENABLE ROW LEVEL SECURITY;

-- 2. Enable RLS on mensajes_incidencia table if not already enabled
ALTER TABLE public.mensajes_incidencia ENABLE ROW LEVEL SECURITY;

-- 3. Drop existing policies if they exist (to avoid conflicts)
DROP POLICY IF EXISTS "Authenticated users can create incidencias" ON public.incidencias;
DROP POLICY IF EXISTS "Users can view their own incidencias" ON public.incidencias;
DROP POLICY IF EXISTS "Users can update their own incidencias" ON public.incidencias;
DROP POLICY IF EXISTS "Users can create mensajes for their incidencias" ON public.mensajes_incidencia;
DROP POLICY IF EXISTS "Users can view mensajes for their incidencias" ON public.mensajes_incidencia;

-- 4. Create RLS policies for incidencias table
CREATE POLICY "Authenticated users can create incidencias" ON public.incidencias
FOR INSERT WITH CHECK (auth.role() = 'authenticated');

CREATE POLICY "Users can view their own incidencias" ON public.incidencias
FOR SELECT USING (
  auth.role() = 'authenticated' AND (
    cliente_id IN (
      SELECT id FROM clientes WHERE user_id = auth.uid()
    ) OR
    asesor_id IN (
      SELECT id FROM profiles WHERE id = auth.uid() AND rol = 'asesor'
    ) OR
    EXISTS (
      SELECT 1 FROM profiles WHERE id = auth.uid() AND rol = 'admin'
    )
  )
);

CREATE POLICY "Users can update their own incidencias" ON public.incidencias
FOR UPDATE USING (
  auth.role() = 'authenticated' AND (
    cliente_id IN (
      SELECT id FROM clientes WHERE user_id = auth.uid()
    ) OR
    asesor_id IN (
      SELECT id FROM profiles WHERE id = auth.uid() AND rol = 'asesor'
    ) OR
    EXISTS (
      SELECT 1 FROM profiles WHERE id = auth.uid() AND rol = 'admin'
    )
  )
);

-- 5. Create RLS policies for mensajes_incidencia table
CREATE POLICY "Users can create mensajes for their incidencias" ON public.mensajes_incidencia
FOR INSERT WITH CHECK (
  auth.role() = 'authenticated' AND
  incidencia_id IN (
    SELECT id FROM incidencias WHERE 
    cliente_id IN (SELECT id FROM clientes WHERE user_id = auth.uid()) OR
    asesor_id IN (SELECT id FROM profiles WHERE id = auth.uid() AND rol = 'asesor') OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND rol = 'admin')
  )
);

CREATE POLICY "Users can view mensajes for their incidencias" ON public.mensajes_incidencia
FOR SELECT USING (
  auth.role() = 'authenticated' AND
  incidencia_id IN (
    SELECT id FROM incidencias WHERE 
    cliente_id IN (SELECT id FROM clientes WHERE user_id = auth.uid()) OR
    asesor_id IN (SELECT id FROM profiles WHERE id = auth.uid() AND rol = 'asesor') OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND rol = 'admin')
  )
);

-- 6. Verify policies were created
SELECT schemaname, tablename, policyname, permissive, roles, cmd, qual 
FROM pg_policies 
WHERE tablename IN ('incidencias', 'mensajes_incidencia')
ORDER BY tablename, policyname;

-- Migration: Add Panel Financiero tables
-- Description: Creates tables for financial documents, analyses, and queries

-- Table: documentos_financieros
-- Stores financial documents uploaded by advisors (P&L, Balance, Excel, etc.)
CREATE TABLE IF NOT EXISTS documentos_financieros (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  cliente_id UUID NOT NULL REFERENCES clientes(id) ON DELETE CASCADE,
  asesor_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,
  nombre TEXT NOT NULL,
  tipo TEXT NOT NULL CHECK (tipo IN ('pyg', 'balance', 'mayor', 'extracto', 'excel', 'otro_financiero')),
  periodo TEXT NOT NULL, -- e.g., "Q1 2024", "2024", "Enero 2024"
  fecha_subida TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  url_archivo TEXT NOT NULL,
  tamanio BIGINT NOT NULL,
  procesado_ia BOOLEAN NOT NULL DEFAULT FALSE,
  datos_extraidos JSONB, -- Extracted data from the document
  analisis_ia JSONB, -- AI analysis result
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table: consultas_financieras
-- Stores natural language queries from clients and AI responses
CREATE TABLE IF NOT EXISTS consultas_financieras (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  cliente_id UUID NOT NULL REFERENCES clientes(id) ON DELETE CASCADE,
  pregunta TEXT NOT NULL,
  respuesta TEXT NOT NULL,
  fecha TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  documentos_referenciados UUID[], -- Array of document IDs referenced in the response
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Indexes for better query performance
CREATE INDEX IF NOT EXISTS idx_documentos_financieros_cliente ON documentos_financieros(cliente_id);
CREATE INDEX IF NOT EXISTS idx_documentos_financieros_asesor ON documentos_financieros(asesor_id);
CREATE INDEX IF NOT EXISTS idx_documentos_financieros_periodo ON documentos_financieros(periodo);
CREATE INDEX IF NOT EXISTS idx_documentos_financieros_fecha ON documentos_financieros(fecha_subida DESC);

CREATE INDEX IF NOT EXISTS idx_consultas_financieras_cliente ON consultas_financieras(cliente_id);
CREATE INDEX IF NOT EXISTS idx_consultas_financieras_fecha ON consultas_financieras(fecha DESC);

-- Function to update updated_at timestamp
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger for documentos_financieros
DROP TRIGGER IF EXISTS update_documentos_financieros_updated_at ON documentos_financieros;
CREATE TRIGGER update_documentos_financieros_updated_at
  BEFORE UPDATE ON documentos_financieros
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

-- Row Level Security (RLS) policies

-- Enable RLS
ALTER TABLE documentos_financieros ENABLE ROW LEVEL SECURITY;
ALTER TABLE consultas_financieras ENABLE ROW LEVEL SECURITY;

-- Policies for documentos_financieros
-- Admins can see all documents
CREATE POLICY "Admins can view all financial documents"
  ON documentos_financieros FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM profiles
      WHERE profiles.id = auth.uid()
      AND profiles.rol = 'admin'
    )
  );

-- Advisors can see documents for their assigned clients
CREATE POLICY "Advisors can view their clients' financial documents"
  ON documentos_financieros FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM asesor_cliente
      WHERE asesor_cliente.asesor_id = auth.uid()
      AND asesor_cliente.cliente_id = documentos_financieros.cliente_id
    )
  );

-- Clients can see their own financial documents
CREATE POLICY "Clients can view their own financial documents"
  ON documentos_financieros FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM clientes
      WHERE clientes.id = documentos_financieros.cliente_id
      AND clientes.user_id = auth.uid()
    )
  );

-- Advisors can insert documents for their clients
CREATE POLICY "Advisors can insert financial documents for their clients"
  ON documentos_financieros FOR INSERT
  WITH CHECK (
    EXISTS (
      SELECT 1 FROM asesor_cliente
      WHERE asesor_cliente.asesor_id = auth.uid()
      AND asesor_cliente.cliente_id = documentos_financieros.cliente_id
    )
  );

-- Advisors can update documents for their clients
CREATE POLICY "Advisors can update financial documents for their clients"
  ON documentos_financieros FOR UPDATE
  USING (
    EXISTS (
      SELECT 1 FROM asesor_cliente
      WHERE asesor_cliente.asesor_id = auth.uid()
      AND asesor_cliente.cliente_id = documentos_financieros.cliente_id
    )
  );

-- Advisors can delete documents for their clients
CREATE POLICY "Advisors can delete financial documents for their clients"
  ON documentos_financieros FOR DELETE
  USING (
    EXISTS (
      SELECT 1 FROM asesor_cliente
      WHERE asesor_cliente.asesor_id = auth.uid()
      AND asesor_cliente.cliente_id = documentos_financieros.cliente_id
    )
  );

-- Policies for consultas_financieras
-- Admins can see all queries
CREATE POLICY "Admins can view all financial queries"
  ON consultas_financieras FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM profiles
      WHERE profiles.id = auth.uid()
      AND profiles.rol = 'admin'
    )
  );

-- Advisors can see queries from their assigned clients
CREATE POLICY "Advisors can view their clients' financial queries"
  ON consultas_financieras FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM asesor_cliente
      WHERE asesor_cliente.asesor_id = auth.uid()
      AND asesor_cliente.cliente_id = consultas_financieras.cliente_id
    )
  );

-- Clients can see their own queries
CREATE POLICY "Clients can view their own financial queries"
  ON consultas_financieras FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM clientes
      WHERE clientes.id = consultas_financieras.cliente_id
      AND clientes.user_id = auth.uid()
    )
  );

-- Clients can insert their own queries (through the app)
CREATE POLICY "Clients can insert their own financial queries"
  ON consultas_financieras FOR INSERT
  WITH CHECK (
    EXISTS (
      SELECT 1 FROM clientes
      WHERE clientes.id = consultas_financieras.cliente_id
      AND clientes.user_id = auth.uid()
    )
  );

-- Grant necessary permissions
GRANT ALL ON documentos_financieros TO authenticated;
GRANT ALL ON consultas_financieras TO authenticated;

-- ============================================
-- E2 ASSISTANT TABLES
-- ============================================
-- Migration to add E2 Assistant conversation storage
-- Created: October 28, 2025

-- Conversations table for storing chat sessions
CREATE TABLE IF NOT EXISTS conversaciones_asistente (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  cliente_id UUID REFERENCES clientes(id) ON DELETE CASCADE,
  titulo TEXT NOT NULL DEFAULT 'Nueva consulta',
  fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  fecha_ultima_actividad TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  derivado_a_asesor BOOLEAN DEFAULT false,
  asesor_id UUID REFERENCES profiles(id) ON DELETE SET NULL,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Messages table for storing individual chat messages
CREATE TABLE IF NOT EXISTS mensajes_asistente (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  conversacion_id UUID REFERENCES conversaciones_asistente(id) ON DELETE CASCADE,
  rol TEXT NOT NULL CHECK (rol IN ('usuario', 'asistente')),
  contenido TEXT NOT NULL,
  metadatos JSONB, -- For storing action buttons, document links, etc.
  es_derivacion BOOLEAN DEFAULT false,
  fecha TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Knowledge base table for E2 Assistant training data
CREATE TABLE IF NOT EXISTS base_conocimiento_e2 (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  categoria TEXT NOT NULL, -- 'fiscal', 'laboral', 'contable', 'explicativo'
  subcategoria TEXT,
  pregunta TEXT NOT NULL,
  respuesta TEXT NOT NULL,
  palabras_clave TEXT[], -- For semantic search
  fuente_oficial TEXT, -- Reference to official documentation
  vigencia_desde DATE,
  vigencia_hasta DATE,
  prioridad INTEGER DEFAULT 0, -- Higher priority answers shown first
  num_usos INTEGER DEFAULT 0, -- Track usage for analytics
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Tax calendar/deadlines table
CREATE TABLE IF NOT EXISTS calendario_fiscal (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  modelo TEXT NOT NULL, -- e.g., '303', '111', '130', etc.
  descripcion TEXT NOT NULL,
  periodo TEXT NOT NULL, -- 'mensual', 'trimestral', 'anual'
  mes_vencimiento INTEGER, -- 1-12
  dia_vencimiento INTEGER, -- 1-31
  trimestre INTEGER, -- 1-4 for quarterly taxes
  obligatorio_autonomos BOOLEAN DEFAULT false,
  obligatorio_sociedades BOOLEAN DEFAULT false,
  notas TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Client-specific tax reminders
CREATE TABLE IF NOT EXISTS recordatorios_fiscales (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  cliente_id UUID REFERENCES clientes(id) ON DELETE CASCADE,
  calendario_fiscal_id UUID REFERENCES calendario_fiscal(id) ON DELETE CASCADE,
  fecha_vencimiento DATE NOT NULL,
  completado BOOLEAN DEFAULT false,
  fecha_completado TIMESTAMP WITH TIME ZONE,
  notas TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- ============================================
-- INDEXES for performance
-- ============================================

CREATE INDEX idx_conversaciones_cliente ON conversaciones_asistente(cliente_id, fecha_ultima_actividad DESC);
CREATE INDEX idx_mensajes_conversacion ON mensajes_asistente(conversacion_id, fecha);
CREATE INDEX idx_base_conocimiento_categoria ON base_conocimiento_e2(categoria);
CREATE INDEX idx_base_conocimiento_keywords ON base_conocimiento_e2 USING GIN(palabras_clave);
CREATE INDEX idx_calendario_fiscal_periodo ON calendario_fiscal(periodo, mes_vencimiento);
CREATE INDEX idx_recordatorios_cliente_fecha ON recordatorios_fiscales(cliente_id, fecha_vencimiento);

